# Secrets must never reach an image layer.
.env
.env.*
!.env.example
*.pem
*.key

# Local environments and caches
.venv/
.venv-ui/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Not needed at runtime
.git/
.github/
Docs/
notebooks/
tests/
artifacts/
sentineliq.egg-info/
# frontend/ is deliberately NOT excluded. The UI image builds from this same
# context (docker-compose `ui.build.context: .`) and copies frontend/app.py
# and frontend/requirements.txt, so excluding it makes that image unbuildable.
# The backend image never copies it, so leaving it in the context costs
# nothing.
# Completed NO-GO quantization study. `COPY scripts/` would otherwise ship it,
# and it imports psutil, which is not a production dependency.
scripts/experiments/

# The raw EDGAR/CUAD download cache: 214 MB the API never reads. The extracted
# documents it does read live in data/raw/documents and are kept, as are
# questions.json and stage8_baseline_results.json, which the API serves.
data/evaluation/datasets/
data/uploads/
sentineliq.db
