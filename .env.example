# LLM Providers — add the one(s) you use
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Retrieval providers
# By default, SentinelIQ uses local models (bge-base-en-v1.5 + bge-reranker-v2-m3).
# For the demo deployment, set both provider vars to "voyage" for fast hosted
# inference with no cold-start. Requires a Voyage AI API key.
# Private/enterprise deployments should keep local so documents never leave the
# controlled environment.
#
# Provider options: local | voyage
RETRIEVAL_EMBEDDING_PROVIDER=local
RETRIEVAL_RERANKER_PROVIDER=local
#
# Voyage AI API key — required when either provider above is set to "voyage".
# Get a key at https://dash.voyageai.com/  (200M free tokens; no card required)
# voyage-law-2 (embedding) and rerank-2 (reranking) are recommended for legal
# and financial document retrieval.
VOYAGE_API_KEY=

# Database
# Local prototype default is SQLite (used when this is unset):
#   sqlite:///sentineliq.db
# Production uses PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/sentineliq

# Password for the Postgres container in docker-compose. docker-compose sets
# DATABASE_URL itself from this, so leave DATABASE_URL alone for that stack.
POSTGRES_PASSWORD=

# Run the test suite against Postgres instead of in-memory SQLite (optional).
# Must be a database of its own — the tests drop their tables:
#   TEST_DATABASE_URL=postgresql://sentineliq:PASSWORD@localhost:5433/sentineliq_test
TEST_DATABASE_URL=

# App
# REQUIRED for the API — signs auth tokens. There is no default on purpose.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENVIRONMENT=development
LOG_LEVEL=INFO
# true writes JSON log lines with the NFR-006 metadata fields
# (investigation_id, tenant_id, agent, step, duration_ms, tokens, status,
# error). docker-compose turns this on for the API container.
LOG_STRUCTURED=false

# Where uploaded documents are written. Leave blank locally (defaults to the
# relative data/uploads). In a container set an ABSOLUTE path on a mounted
# volume, or uploads are lost on restart while their database rows survive.
SENTINELIQ_UPLOAD_DIR=

# Demo mode. OFF unless this is exactly true/1/yes. When on, a request with no
# bearer token is served as a fixed demo principal (analyst role, never admin)
# in the demo tenant below, so an interviewer can use the app without an
# account. JWT, RBAC and tenant isolation are unchanged; a request that DOES
# carry a token is still authenticated by it.
# Everyone shares the demo tenant, so treat anything uploaded there as public.
#
# docker-compose.yml already defaults this to true for local showcase — you
# only need to set it here when running the API directly (outside Docker), or
# to override the compose default (set false to require authentication).
SENTINELIQ_DEMO_MODE=false
SENTINELIQ_DEMO_TENANT=demo-tenant

# CrewAI's own telemetry is on by default and exports spans to its collector.
# true stops that outbound traffic and the failed-export log noise. This is the
# variable crewai 1.15.16 reads; the older CREWAI_TELEMETRY_OPT_OUT is inert.
# Do NOT use OTEL_SDK_DISABLED instead — that is global and would also switch
# off LangSmith tracing.
CREWAI_DISABLE_TELEMETRY=true

# Reranker half precision. Leave blank/true on a GPU. Set false on a CPU-only
# host such as an EC2 instance: fp16 is a GPU memory optimisation and torch
# runs it slowly on CPU. Full precision is the more exact of the two, so this
# does not degrade retrieval. No other retrieval setting can be overridden.
RETRIEVAL_FP16=

# Streamlit -> FastAPI. Change only if the API is not on localhost:8000.
SENTINELIQ_API_URL=http://127.0.0.1:8000

# LangSmith (set LANGCHAIN_TRACING_V2=true to enable tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sentineliq

# SEC EDGAR — required descriptive User-Agent (name + contact email)
SEC_USER_AGENT=SentinelIQ your.name@example.com

# Web search (optional — leave blank to disable)
SERPER_API_KEY=
TAVILY_API_KEY=
